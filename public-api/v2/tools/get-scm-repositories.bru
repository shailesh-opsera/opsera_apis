meta {
  name: Get SCM Repositories
  type: http
  seq: 4
}

post {
  url: {{baseUrl_publicApi}}/api/v2/tools/scm/repositories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tool_id": "<toolId>",
    "service": "github",
    "workspace": "my-workspace",
    "searchTerm": "api",
    "pageSize": 100,
    "currentPage": 1
  }
}
