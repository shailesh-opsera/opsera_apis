meta {
  name: Get SCM Branches
  type: http
  seq: 3
}

post {
  url: {{baseUrl_publicApi}}/api/v2/tools/scm/branches
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tool_id": "<toolId>",
    "service": "github",
    "repository": "myorg/my-node-api",
    "workspace": "my-workspace",
    "searchTerm": "feature"
  }
}
