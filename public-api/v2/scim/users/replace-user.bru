meta {
  name: Replace User
  type: http
  seq: 5
}

put {
  url: {{baseUrl_publicApi}}/api/v2/scim/v2/Users/<userId>
  body: json
  auth: inherit
}

headers {
  Content-Type: application/scim+json
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
    "name": {
      "givenName": "John",
      "familyName": "Doe"
    },
    "emails": [
      {
        "value": "john.doe@example.com",
        "type": "work",
        "primary": true
      }
    ],
    "active": true,
    "roles": [
      {
        "value": "powerUser",
        "primary": true
      }
    ]
  }
}
