meta {
  name: Search Users
  type: http
  seq: 3
}

post {
  url: {{baseUrl_publicApi}}/api/v2/scim/v2/Users/.search
  body: json
  auth: inherit
}

headers {
  Content-Type: application/scim+json
}

body:json {
  {
    "filter": "userName eq \"john.doe@example.com\"",
    "startIndex": 1,
    "count": 100
  }
}
