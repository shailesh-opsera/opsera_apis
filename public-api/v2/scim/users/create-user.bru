meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl_publicApi}}/api/v2/scim/v2/Users
  body: json
  auth: inherit
}

headers {
  Content-Type: application/scim+json
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
    "name": {
      "givenName": "John",
      "familyName": "Doe"
    },
    "emails": [
      {
        "value": "john.doe@example.com",
        "type": "work",
        "primary": true
      }
    ],
    "active": true,
    "roles": [
      {
        "value": "user",
        "primary": true,
        "type": "Primary"
      }
    ]
  }
}
