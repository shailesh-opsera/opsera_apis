meta {
  name: Patch User
  type: http
  seq: 6
}

patch {
  url: {{baseUrl_publicApi}}/api/v2/scim/v2/Users/<userId>
  body: json
  auth: inherit
}

headers {
  Content-Type: application/scim+json
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
    "Operations": [
      {
        "op": "replace",
        "path": "active",
        "value": "false"
      }
    ]
  }
}
