meta {
  name: SCM To SCM CSV Upload
  type: http
  seq: 5
}

post {
  url: {{baseUrl_publicApi}}/api/v2/tasks/scmtoscm/csvupload
  body: text
  auth: inherit
}

headers {
  Content-Type: text/plain
}

params:query {
  taskId: <taskId>
  sourceGitToolId: <sourceGitToolId>
  targetGitToolId: <targetGitToolId>
  sourceScmType: gitlab
  targetScmType: github
  ~skipFailed: false
}

body:text {
  sourceRepoName,targetOrgName,targetRepoName
  my-source-repo,target-org,my-target-repo
  another-repo,target-org,migrated-repo
}
