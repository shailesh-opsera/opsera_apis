meta {
  name: Run Pipeline With Notification
  type: http
  seq: 6
}

post {
  url: {{baseUrl_publicApi}}/api/v2/pipelines/pipeline-run/notification
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "<pipelineId>",
    "notificationSettings": {
      "approvalMessage": "Please approve this execution",
      "sendCustomMessage": true
    }
  }
}
