            "tool_identifier": "jenkins",
            "configuration": {
              "jobName": "my-test-job",
              "buildType": "maven"
            }
          },
          "active": true,
          "dependencies": ["Build Step"]
        }
      ]
    },
    "tags": ["validated", "ci-cd"],
    "metadata": {}
  }
}
