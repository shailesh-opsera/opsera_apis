meta {
  name: Update Filter
  type: http
  seq: 3
}

put {
  url: {{baseUrl_publicApi}}/api/v2/insights/filters/<filterId>
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mappingId": "<mappingId>",
    "tool": "github",
    "name": "repository_filter",
    "values": ["repo1", "repo2", "repo3"],
    "kpis": ["kpi-uuid-1", "kpi-uuid-2"],
    "custom_fieldName": "custom_repo_field",
    "labels": ["production", "critical"],
    "source": "user",
    "active": true,
    "sort_number": 1
  }
}
